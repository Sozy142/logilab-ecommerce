{
  "name": "logilab-server-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test src/services/auth.schemas.test.ts",
    "build": "tsc -p tsconfig.json",
